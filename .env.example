# Copy to .env and edit. Mise loads .env through mise.toml.
# Defaults match compose.yaml; use your own values elsewhere.
# Remove database_url from any Looster TOML config to use the PG variables below.

# Logical namespace for tasks, manifests and servers. Existing data uses default.
LOOSTER_NAMESPACE=default

# PostgreSQL: one shared login for the CLI and server.
PGHOST=localhost
PGPORT=5432
PGDATABASE=looster
PGUSER=postgres
PGPASSWORD=postgres
PGSSLMODE=disable
PGCONNECT_TIMEOUT=10
PGAPPNAME=looster

# Optional alternatives. Native names above take precedence over aliases.
# PG_PASS=postgres
# PG_HOST=localhost
# PG_PORT=5432
# PG_DB=looster
# PG_USER=postgres

# Optional TLS, password-file, and service-file configuration.
# PGSSLROOTCERT=/path/to/root.crt
# PGSSLCERT=/path/to/client.crt
# PGSSLKEY=/path/to/client.key
# PGSSLPASSWORD=replace-me
# PGPASSFILE=/path/to/pgpass
# PGSERVICE=looster
# PGSERVICEFILE=/path/to/pg_service.conf
# PGOPTIONS='-c statement_timeout=30000'

# Optional connection string. Explicit fields override the PG variables above.
# LOOSTER_DATABASE_URL='postgres://postgres:postgres@localhost:5432/looster?sslmode=disable&pool_max_conns=16'

# S3-compatible object storage (local Compose defaults).
LOOSTER_S3_ENDPOINT=http://localhost:4566
LOOSTER_S3_REGION=us-east-1
LOOSTER_S3_BUCKET=looster
LOOSTER_S3_ACCESS_KEY=test
LOOSTER_S3_SECRET_KEY=test

# For AWS S3, remove LOOSTER_S3_ENDPOINT. To use the standard AWS credential
# chain, remove LOOSTER_S3_ACCESS_KEY and LOOSTER_S3_SECRET_KEY above.
# AWS_ACCESS_KEY_ID=replace-me
# AWS_SECRET_ACCESS_KEY=replace-me
# AWS_SESSION_TOKEN=replace-me
# AWS_PROFILE=your-profile

# Worker configuration (used by looster serve).
LOOSTER_HARNESS=jcode
LOOSTER_AGENTS=designer,coder,reviewer
LOOSTER_CONCURRENCY=4
LOOSTER_WORKDIR=./workdirs
LOOSTER_POLL_INTERVAL=1s
LOOSTER_RUN_TIMEOUT=1h
LOOSTER_JCODE_BINARY=jcode
# LOOSTER_JCODE_SESSIONS_DIR=/path/to/.jcode/sessions

# Application role is human by default. The server sets agent mode and identity
# automatically in each harness. These are optional for a manually run agent CLI.
# LOOSTER_ROLE=agent
# LOOSTER_AGENT=coder
